# Neon Postgres connection string (Neon dashboard → Connect → copy). Keep it secret.
DATABASE_URL=

# First admin login, used on the first start (and by `python -m app.reset_admin`).
# After that, change it from Admin → Admin account.
ADMIN_USERNAME=adminname
ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional. Only used the very first time the database is created.
# After that, manage QR codes and the support number in Admin → Payment QR.
UPI_ID=
UPI_PAYEE_NAME=G-CATION
CONTACT_PHONE=

# Set to true when the site runs on HTTPS (production)
COOKIE_SECURE=false
