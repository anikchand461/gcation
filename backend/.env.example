# Neon Postgres connection string (Neon dashboard → Connect → copy). Keep it secret.
DATABASE_URL=

# Fixed admin login (there is no admin sign-up). Use a strong password.
ADMIN_USERNAME=adminname
ADMIN_PASSWORD=change-this-to-a-strong-password

# Used once to fill the primary QR when the database is first created.
# After that, manage both QR codes from Admin → Payment QR.
UPI_ID=yourname@okaxis
UPI_PAYEE_NAME=G-CATION
CONTACT_PHONE=+91 98765 43210

# Set to true when the site runs on HTTPS (production)
COOKIE_SECURE=false
